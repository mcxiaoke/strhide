    email: mcxiaoke@live.com
license: Apache-2.0
repository-code: "https://github.com/mcxiaoke/strhide"
url: "https://github.com/mcxiaoke/strhide"
version: 0.9.3
keywords:
  - steganography
  - data hiding
  - format-preserving
  - lossless
  - AES-256-GCM
  - steganalysis
  - Rust
